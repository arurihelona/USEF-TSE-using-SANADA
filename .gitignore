# 1. Model Weights & Large Checkpoints (>100MB)
# Note: Use Git LFS or external artifact repositories (Google Drive / Hugging Face)
*.pt
*.pth
*.pth.tar
*.ckpt
*.bin
SANADA_USEF_Experiments/
**/checkpoints/*.pt
**/checkpoints/*.pth.tar
**/checkpoints/*.ckpt

# 2. Raw Datasets & Large Archives
SANADA_Full_Evaluation_Results/
*.zip
*.tar.gz
*.tgz
*.7z

# 3. Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# 4. Bytecode & Cache Files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# 5. Node.js & Vite Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 6. Environment Configurations & Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.secret

# 7. Generated Outputs & Temporary Files
**/temp/*
!**/temp/.gitkeep
*.orig
*.bak
*.swp
*.tmp

# 8. OS & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
