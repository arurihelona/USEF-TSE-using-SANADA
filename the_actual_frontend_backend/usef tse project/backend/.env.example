# USEF-TSE Backend Environment Configuration
# Copy this file to .env and set values as needed.
# The .env file is NOT loaded automatically — set variables in your shell or
# system environment before starting the backend.

# =============================================================================
# CHECKPOINT CONFIGURATION
# =============================================================================
# Override the checkpoint path. Leave unset to use the default priority order:
#   1. best_stage_c_sanada.pt  (Stage C fine-tuned — PRODUCTION default)
#   2. usef_tfgridnet_wsj02mix.pth.tar  (original pretrained — baseline fallback)
#
# To use the Stage C checkpoint explicitly (default behaviour, no override needed):
# USEF_CHECKPOINT=
#
# To switch to the pretrained baseline for comparison:
# USEF_CHECKPOINT=checkpoints/usef_tfgridnet_wsj02mix.pth.tar
#
# To use a custom checkpoint:
# USEF_CHECKPOINT=/absolute/path/to/your_checkpoint.pt

# Example for Windows PowerShell before starting:
#   $env:USEF_CHECKPOINT = "checkpoints\usef_tfgridnet_wsj02mix.pth.tar"
#   python app.py

# Example for Linux/macOS:
#   USEF_CHECKPOINT=checkpoints/usef_tfgridnet_wsj02mix.pth.tar python app.py
