# USEF-TSE Backend Environment Configuration
# Copy this file to .env and set values as needed.
# The .env file is NOT loaded automatically — set variables in your shell,
# container runtime, or hosting platform before starting the backend.

# =============================================================================
# SERVER & DEPLOYMENT CONFIGURATION
# =============================================================================
# Bind host and port (platforms like Render/Railway/Fly inject PORT automatically)
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins (default: * for local/initial setup)
# For split frontend/backend hosting in production, set to your frontend origin:
# CORS_ORIGINS=https://your-frontend.example.com
CORS_ORIGINS=*

# Retention TTL (seconds, minimum 60) for extracted WAV files in backend/temp/
# Note: Run Uvicorn with a single worker (--workers 1) because active-download
# protection in backend/app.py is process-local.
TEMP_FILE_TTL_SECONDS=1800

# Optional override for the built frontend-user static directory
# Defaults to ../frontend-user/dist when present
# FRONTEND_DIST_DIR=../frontend-user/dist

# =============================================================================
# CHECKPOINT CONFIGURATION
# =============================================================================
# Override the checkpoint path. Leave unset to use the default priority order:
#   1. best_stage_c_sanada.pt  (Stage C fine-tuned — PRODUCTION default)
#   2. usef_tfgridnet_wsj02mix.pth.tar  (original pretrained — baseline fallback)
#
# To use the Stage C checkpoint explicitly (default behaviour, no override needed):
# USEF_CHECKPOINT=
#
# To switch to the pretrained baseline for comparison:
# USEF_CHECKPOINT=checkpoints/usef_tfgridnet_wsj02mix.pth.tar
#
# To use a custom checkpoint:
# USEF_CHECKPOINT=/absolute/path/to/your_checkpoint.pt

# Example for Windows PowerShell before starting:
#   $env:USEF_CHECKPOINT = "checkpoints\usef_tfgridnet_wsj02mix.pth.tar"
#   python app.py

# Example for Linux/macOS:
#   USEF_CHECKPOINT=checkpoints/usef_tfgridnet_wsj02mix.pth.tar python app.py
